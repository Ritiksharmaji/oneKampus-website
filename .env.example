# Copy to .env and fill in.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/onekampus_website"
# Long random string used to sign admin sessions: openssl rand -base64 48
AUTH_SECRET=""
# Public address of the site, used for sitemap, canonical URLs and emails
SITE_URL="https://onekampus.com"

# First admin account, created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@onekampus.com"
SEED_ADMIN_PASSWORD=""

# New-lead emails. Without SMTP_HOST, emails are printed in the server log instead.
LEADS_NOTIFY_EMAIL="sales@onekampus.com"
MAIL_FROM="oneKampus <no-reply@onekampus.com>"
SMTP_HOST=""          # e.g. smtp.zoho.in, smtp.gmail.com, smtp.resend.com
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
